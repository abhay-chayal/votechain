# Copy to .env before deploying to Sepolia. Never commit .env.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Private key of the wallet that deploys the contract (needs a little Sepolia ETH).
DEPLOYER_PRIVATE_KEY=
# Address of the backend's relayer wallet. Leave empty to use the deployer wallet as relayer.
RELAYER_ADDRESS=
# Optional: publishes the contract source on Etherscan (npm run verify:sepolia).
ETHERSCAN_API_KEY=
