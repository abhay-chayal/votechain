# Copy to .env for local use. On Render, set these in the dashboard instead.
NODE_ENV=development
PORT=4000

# Leave empty locally to use an embedded in-memory MongoDB. In production: your Atlas URI.
MONGODB_URI=

# Long random strings in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# VOTER_TOKEN_SECRET keeps on-chain voter tokens unlinkable to email addresses. Keep it private.
JWT_SECRET=
JWT_REFRESH_SECRET=
VOTER_TOKEN_SECRET=

# Where the web app runs (for CORS and links in emails). Comma-separate several.
CLIENT_URL=http://localhost:5173

# Blockchain: "localhost" (Hardhat) or "sepolia". The contract address and ABI come from
# src/chain/deployment.<network>.json, written by the deploy script in /contracts.
CHAIN_NETWORK=localhost
# Private RPC the API sends transactions through (e.g. an Alchemy or Infura Sepolia URL).
RPC_URL=
# Key-free public RPC the browser uses to double-check results.
PUBLIC_RPC_URL=
# Private key of the relayer wallet (0x…). It pays gas for every vote. Keep it secret.
RELAYER_PRIVATE_KEY=

# Created automatically at startup if it does not exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP for sign-in codes and invites (e.g. Brevo, Resend, or Gmail with an app password).
# Without it, emails are printed to the server log and sign-in codes are shown on screen (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VoteChain <no-reply@yourdomain.com>
